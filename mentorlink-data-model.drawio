                <mxCell id="tutor-b" parent="tutor" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;div&gt;id&lt;/div&gt;&lt;div&gt;user: OneToOne → CustomUser, CASCADE&lt;/div&gt;&lt;div&gt;subjects: ManyToMany → Subject, blank&lt;/div&gt;&lt;div&gt;bio: TextField, blank&lt;/div&gt;&lt;div&gt;years_of_experience: PositiveSmallInt, default 0&lt;/div&gt;&lt;div&gt;education_level: CharField, &lt;b&gt;choices&lt;/b&gt;, blank&lt;/div&gt;&lt;div&gt;qualification: CharField, blank&lt;/div&gt;&lt;div&gt;institution: CharField, blank&lt;/div&gt;&lt;div&gt;hourly_rate: Decimal(2 dp), blank + null&lt;/div&gt;&lt;div&gt;is_verified: BooleanField, default False&lt;/div&gt;" vertex="1"><mxGeometry height="230" width="380" y="30" as="geometry"/></mxCell>
                <mxCell id="subject" parent="1" style="swimlane;startSize=0;" value="" vertex="1"><mxGeometry height="140" width="380" x="40" y="480" as="geometry"/></mxCell>
