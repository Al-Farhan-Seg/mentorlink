                <mxCell id="slot-b" parent="slot" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;div&gt;id&lt;/div&gt;&lt;div&gt;tutor: FK → TutorProfile, CASCADE&lt;/div&gt;&lt;div&gt;start_at: DateTimeField&lt;/div&gt;&lt;div&gt;end_at: DateTimeField&lt;/div&gt;&lt;div&gt;&lt;b&gt;unique&lt;/b&gt; (tutor, start_at)&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font color=&quot;#888888&quot;&gt;available = no pending/confirmed booking&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="150" width="380" y="30" as="geometry"/></mxCell>
                <mxCell id="e0" edge="1" parent="1" source="user" target="tutor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToOne;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" value="1:0..1 (tutors only)"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e1" edge="1" parent="1" source="user" target="booking" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERmany;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" value="1:N student"><mxGeometry relative="1" as="geometry"/></mxCell>
