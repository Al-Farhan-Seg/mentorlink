                <mxCell id="subject-b" parent="subject" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;div&gt;id&lt;/div&gt;&lt;div&gt;subject_name: CharField, &lt;b&gt;unique&lt;/b&gt;&lt;/div&gt;&lt;div&gt;subject_code: CharField, &lt;b&gt;unique&lt;/b&gt;, optional&lt;/div&gt;&lt;div&gt;description: TextField, blank&lt;/div&gt;" vertex="1"><mxGeometry height="110" width="380" y="30" as="geometry"/></mxCell>
                <mxCell id="booking" parent="1" style="swimlane;startSize=0;" value="" vertex="1"><mxGeometry height="240" width="380" x="480" y="480" as="geometry"/></mxCell>
                <mxCell id="booking-h" parent="booking" style="whiteSpace=wrap;html=1;fontStyle=1;" value="Booking - bookings" vertex="1"><mxGeometry height="30" width="380" as="geometry"/></mxCell>
                <mxCell id="booking-b" parent="booking" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;div&gt;id&lt;/div&gt;&lt;div&gt;student: FK → CustomUser, CASCADE&lt;/div&gt;&lt;div&gt;slot: FK → AvailabilitySlot, PROTECT&lt;/div&gt;&lt;div&gt;subject: FK → Subject, PROTECT&lt;/div&gt;&lt;div&gt;status: CharField, &lt;b&gt;choices&lt;/b&gt; (pending, confirmed,&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;cancelled, completed), default pending&lt;/div&gt;&lt;div&gt;notes: TextField, blank&lt;/div&gt;&lt;div&gt;created_at: DateTimeField, auto_now_add&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font color=&quot;#888888&quot;&gt;tutor comes from slot.tutor (not stored)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="210" width="380" y="30" as="geometry"/></mxCell>
