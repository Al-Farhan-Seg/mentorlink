                <mxCell id="e4" edge="1" parent="1" source="slot" target="booking" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERmany;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" value="1:N"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e5" edge="1" parent="1" source="tutor" target="slot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERmany;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" value="1:N"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="e6" edge="1" parent="1" source="tutor" target="subject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmany;endArrow=ERmany;endFill=0;startFill=0;labelBackgroundColor=#ffffff;" value="N:N (TutorProfile.subjects)"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="rules" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div&gt;&lt;b&gt;Rules enforced in validation (not drawn as fields)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;1. A slot has at most one pending/confirmed booking (cancelled frees it).&lt;/div&gt;&lt;div&gt;2. Booking.subject must be in slot.tutor.subjects.&lt;/div&gt;&lt;div&gt;3. Only role=tutor users get a TutorProfile; only role=student users book.&lt;/div&gt;&lt;div&gt;4. AvailabilitySlot.end_at must be after start_at.&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font color=&quot;#888888&quot;&gt;Admin access comes from is_staff / is_superuser, not role.&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" vertex="1"><mxGeometry height="140" width="620" x="40" y="800" as="geometry"/></mxCell>
            </root>
        </mxGraphModel>
