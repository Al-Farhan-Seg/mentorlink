                <mxCell id="user-b" parent="user" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" value="&lt;div&gt;&lt;i&gt;&lt;font color=&quot;#888888&quot;&gt;Inherited: id, username, password, first_name,&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;&lt;font color=&quot;#888888&quot;&gt;last_name, is_active, is_staff, is_superuser, date_joined&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;&lt;div&gt;email: EmailField, &lt;b&gt;unique&lt;/b&gt;&lt;/div&gt;&lt;div&gt;role: CharField, &lt;b&gt;choices&lt;/b&gt; (student, tutor), default student&lt;/div&gt;&lt;div&gt;phone_number: CharField, blank&lt;/div&gt;&lt;div&gt;gender: CharField, &lt;b&gt;choices&lt;/b&gt;, blank&lt;/div&gt;&lt;div&gt;date_of_birth: DateField, blank + null&lt;/div&gt;" vertex="1"><mxGeometry height="170" width="380" y="30" as="geometry"/></mxCell>
